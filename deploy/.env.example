DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=openlims
POSTGRES_USER=openlims
POSTGRES_PASSWORD=openlims

DATABASE_URL=postgres://openlims:openlims@db:5432/openlims
INSTRUMENT_API_KEY=change-me-in-dev

# Maximum records allowed in one frozen assistant bulk preview.
OPENLIMS_ASSISTANT_BULK_MAX_RECORDS=100

# Optional LLM explanation and fallback intent classification.
OPENLIMS_ASSISTANT_LLM_ENABLED=false
OPENLIMS_ASSISTANT_LLM_PROVIDER=ollama
OPENLIMS_ASSISTANT_LLM_ROUTING_ENABLED=true
OPENLIMS_ASSISTANT_LLM_ROUTING_MIN_CONFIDENCE=0.65
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=25
# Legacy database migration (director-only, read-only source accounts)
MIGRATION_DB_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal
MIGRATION_DB_CONNECT_TIMEOUT=10
MIGRATION_DB_MAX_ROWS=50000
MIGRATION_SQLITE_ROOT=/app/migration_sources
# Store a source password in an environment variable and enter only its name in OpenLIMS.
# SISBI_MIGRATION_PASSWORD=replace-with-read-only-password
