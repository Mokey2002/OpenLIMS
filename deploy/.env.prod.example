# Copy to deploy/.env and replace every CHANGE_ME value before deployment.
DJANGO_SECRET_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=lims.example.edu

# Production browser session security. These assume TLS terminates at Caddy,
# Nginx, a load balancer, or another trusted reverse proxy in front of OpenLIMS.
JWT_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SESSION_COOKIE_SECURE=true
SECURE_SSL_REDIRECT=false
JWT_COOKIE_SAMESITE=Lax

# Internal HTTP port exposed by the OpenLIMS web container to the TLS proxy.
OPENLIMS_HTTP_PORT=8080

POSTGRES_DB=openlims
POSTGRES_USER=openlims
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_STRONG_DATABASE_PASSWORD
DATABASE_URL=postgres://openlims:CHANGE_ME_WITH_A_STRONG_DATABASE_PASSWORD@db:5432/openlims

INSTRUMENT_API_KEY=CHANGE_ME_WITH_A_RANDOM_CONNECTOR_KEY

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CHANNEL_REDIS_URL=redis://redis:6379/2

OPENLIMS_ASSISTANT_BULK_MAX_RECORDS=100

# Optional local LLM. Start with: docker compose -f docker-compose.prod.yml --profile llm up -d
OPENLIMS_ASSISTANT_LLM_ENABLED=false
OPENLIMS_ASSISTANT_LLM_PROVIDER=ollama
OPENLIMS_ASSISTANT_LLM_ROUTING_ENABLED=true
OPENLIMS_ASSISTANT_LLM_ROUTING_MIN_CONFIDENCE=0.65
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=25

# Director-only legacy migration sources. Use a read-only DB account.
MIGRATION_DB_ALLOWED_HOSTS=host.docker.internal
MIGRATION_DB_CONNECT_TIMEOUT=10
MIGRATION_DB_MAX_ROWS=50000
MIGRATION_SQLITE_ROOT=/app/migration_sources
